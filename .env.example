# Sao chép thành `.env` và điền giá trị (không commit `.env`).
# File .env được TỰ ĐỘNG nạp khi khởi động (env_bootstrap.py + python-dotenv) cho app.py
# và các script nền (pg job worker, monthly accountability, snapshot refresh loop).
# Biến đã đặt sẵn trong môi trường hệ thống/launcher luôn thắng giá trị trong .env (override=False).
# Production (II_ENV=prod): bắt buộc II_APP_SECRET_KEY hợp lệ + ít nhất một LLM API key
# (hoặc II_REQUIRE_LLM_KEYS=0 để chạy fallback không LLM) — thiếu sẽ dừng app với lỗi rõ ràng.

# --- LLM (tuỳ chọn; thiếu thì dùng fallback template) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# GROQ_API_KEYS=gsk_key_1;gsk_key_2
# OPENAI_API_KEYS=sk_key_1;sk_key_2
# GEMINI_API_KEYS=AIza_key_1;AIza_key_2
# II_APP_SECRET_KEY=base64url_32bytes_fernet_key

# --- Sentry (giám sát lỗi realtime — UI Streamlit + async worker) ---
# Để trống = tắt (dev/local). Production: dán DSN từ Sentry project.
# II_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# II_SENTRY_TRACES_SAMPLE_RATE=0.0
# II_SENTRY_RELEASE=   # tùy chọn; mặc định lấy II_APP_VERSION
# II_ENV=prod          # gắn tag environment trên Sentry (dev|preprod|prod)

# --- Định giá Graham: lợi suất trái phiếu chuẩn (%/năm), mặc định 4.4 ---
# II_DEFAULT_BOND_YIELD_PCT=4.4

# --- Data layer (Phase 2): vnstock primary + fallback an toàn ---
# Nguồn OHLCV chính: vnstock (VCI). Scale giá VCI (nghìn đồng → VND): mặc định 1000
# II_VNSTOCK_SOURCE=VCI
# II_VNSTOCK_PRICE_SCALE=1000
# II_EPS_SCALE=1000
# Nâng hạn mức Guest (20 req/min) → Community (60 req/min): lấy API key tại https://vnstocks.com/login
# II_VNSTOCK_TOKEN=vnstock_xxxxxxxx
# Hoặc: II_VNSTOCK_API_KEY=vnstock_xxxxxxxx
# Tuỳ chọn (tooling): II_VNSTOCK_USER= / II_VNSTOCK_PASSWORD=
# Retry khi 429 / Read timed out: mặc định 3 lần, backoff 2s → 4s → 8s
# II_VNSTOCK_RETRY_MAX=3
# II_VNSTOCK_RETRY_BASE_SEC=2
# Không dùng đóng cửa cũ từ disk khi mọi live API lỗi (tránh sai MOS/F-Score). Dev/offline:
# II_OHLCV_ALLOW_STALE_DISK_FALLBACK=0
# BCTC: ưu tiên cache đĩa/DB; không cào realtime trong phiên. Refresh đêm/cuối tuần:
#   python scripts/refresh_financial_indicators.py --vn30
# II_FINANCIAL_DISK_FIRST=1
# II_FINANCIAL_LIVE_REFRESH=0
# Nghiệm thu forecast: backfill OHLCV live khi store thiếu bar tại due date (tắt trong pytest)
# II_FORECAST_SETTLE_LIVE_BACKFILL=1

# --- Async jobs (Postgres worker — production) ---
# Bật queue durable: II_DB_URL=postgresql://... + II_USE_PG_ANALYSIS_JOBS=1
# Worker độc lập (bắt buộc khi PG on): python worker.py
#   hoặc: python scripts/run_pg_job_worker.py --lease-sec 900 --heartbeat-sec 30
# Schema Postgres (Alembic — khuyến nghị trên môi trường mới):
#   alembic upgrade head
# (bootstrap app/worker vẫn gọi initialize_database_connection() = CREATE IF NOT EXISTS tương thích.)
# Visibility timeout (PROCESSING quá hạn → PENDING): mặc định 900s (15 phút)
# II_ASYNC_JOB_VISIBILITY_TIMEOUT_SEC=900
# II_USE_PG_FINDER_JOBS=1
# II_USE_PG_SCAN_JOBS=1
# II_USE_PG_AUTOPILOT_JOBS=1
# Tắt daemon thread trong Streamlit khi không có PG (chỉ cho local/dev):
# II_ALLOW_LOCAL_DAEMON_JOBS=0
# II_AUTO_START_PG_WORKER=1

# --- Chất lượng snapshot (mặc định app: ưu tiên giá live; pytest đặt II_SNAPSHOT_PREFER_LIVE=0 trong conftest) ---
# II_SNAPSHOT_PREFER_LIVE=1
# II_SNAPSHOT_ATTACH_LIVE=1
# II_MERGE_LIVE_FUNDAMENTALS=1
# Chi offline / không gọi mạng: II_SNAPSHOT_PREFER_LIVE=0 (ưu tiên mock_json khi có)
# SWR snapshot: trả disk ngay + refresh nền (mặc định bật trong code / run_app.*)
# II_SNAPSHOT_STALE_WHILE_REVALIDATE=1
# Overlay giá trên SWR (mặc định tắt = first-paint tức thì; bật nếu cần giá tươi trong budget):
# II_SNAPSHOT_SWR_PRICE_OVERLAY=0
# II_SNAPSHOT_SWR_PRICE_BUDGET_SEC=2.5
# II_SNAPSHOT_SWR_MIN_REFRESH_SEC=60
# II_READ_STALE_DISK=1
# Thứ tự nguồn giá (mặc định VNDirect API trước để giảm latency): II_QUOTE_PROVIDER_ORDER=vndirect,cafef,vietstock
# CafeF fail-fast: II_CAFEF_MAX_BOARDS=1  II_CAFEF_TIMEOUT=3
# Autopilot/Finder universe: dynamic_liquid (mặc định P3) | liquid | vn30 | rotate_full
# II_AUTOPILOT_UNIVERSE_MODE=dynamic_liquid
# II_UNIVERSE_ROTATE_STYLE=sequential
# Overnight liquid board → morning Autopilot Top 10 (default ON)
# II_AUTOPILOT_NIGHTLY_BOARD=1
# II_AUTOPILOT_NIGHTLY_BOARD_PATH=data/runtime/autopilot_nightly_board.json
# II_AUTOPILOT_NIGHTLY_MAX_AGE_HOURS=36
# II_AUTOPILOT_NIGHTLY_MIN_COVERAGE_PCT=25
# Night job: python scripts/run_autopilot_nightly_scan.py --batch-size 40
# II_SCAN_OHLCV_SESSIONS=80
# II_VNSTOCK_TIMEOUT_SEC=3.5
# II_VNSTOCK_RETRY_MAX=1
# II_OHLCV_ALLOW_STALE_DISK_FALLBACK=1
# Cho OHLCV ghi đè giá CafeF (hiếm khi cần): II_SNAPSHOT_FORCE_OHLCV_CROSSCHECK=1
# Bảng kệ giá nhanh: ưu tiên quote live song song (mặc định theo II_SNAPSHOT_PREFER_LIVE; tắt: =0)
# II_WATCH_SHELF_PREFER_LIVE=1
# II_WATCH_SHELF_QUOTE_MAX_WORKERS=8
# II_WATCHLIST_QUOTE_MAX_WORKERS=8
# Ép bỏ snapshot đĩa khi price_source còn OHLCV fastpath (mặc định tắt — bật sẽ làm chậm Finder quét nhiều mã)
# II_SNAPSHOT_BYPASS_STALE_OHLCV_DISK=1

# Giá thống nhất + quote mới nhất tại thời điểm khách yêu cầu (mặc định ON trong code).
# Không dùng đóng cửa OHLCV kho làm giá hiện tại. Tắt: II_UNIFIED_LIVE_PRICE=0
# II_UNIFIED_LIVE_PRICE=1
# Số ngày tối đa OHLCV còn được coi là "tươi" khi align (chỉ khi UNIFIED=0): II_OHLCV_PRICE_MAX_STALE_DAYS=3

# Finder 3M: song song I/O (ThreadPool; mặc định bật — tắt nếu nguồn hay chặn IP)
# II_FINDER_PARALLEL=1
# II_FINDER_MAX_WORKERS=4

# Finder 3M: số phiên OHLCV (mặc định 220; đủ cho data quality, tránh 1000+ × nhiều mã)
# II_FINDER_OHLCV_SESSIONS=220

# --- Hàng đợi phân tích nền (Postgres, job không mất khi tắt Streamlit) ---
# Bật Postgres: docker compose -f docker-compose.postgres.yml up -d
# II_DB_URL=postgresql://ii_user:ii_pass@127.0.0.1:5432/ii_app
# Chạy worker (terminal riêng): python scripts/run_pg_job_worker.py
# Tắt queue Postgres (dùng lại thread + file trên máy): II_USE_PG_ANALYSIS_JOBS=0
# II_USE_PG_ANALYSIS_JOBS=1
# Finder qua cùng bảng ii_async_jobs: II_USE_PG_FINDER_JOBS=0 để chạy sync trong Streamlit
# Preset Finder UI: quick (lọc nhẹ, mặc định) | quality (lọc chặt cũ)
# II_FINDER_PRESET_DEFAULT=quick
# Tự mở worker minimized (Windows): II_AUTO_START_PG_WORKER=1 cùng II_DB_URL=postgresql://...

# --- PostgreSQL (tùy chọn; mặc định app dùng SQLite) ---
# Khớp docker-compose.postgres.yml: user ii_user, db ii_app, port 5432
# II_DB_URL=postgresql://ii_user:ii_pass@127.0.0.1:5432/ii_app
# Smoke tích hợp: python scripts/run_postgres_smoke_local.py (sau khi docker compose up postgres)

# --- Smoke script: không gọi mạng ---
# II_SMOKE_OFFLINE=1   # hoặc: python scripts/smoke_test.py --offline

# --- Chỉ cổ phiếu niêm yết VN (listing HOSE/HNX/UPCOM); tắt khi test symbol giả: II_VN_SYMBOL_GUARD=0 ---
# II_VN_SYMBOL_GUARD=1

# --- Luân phiên cửa sổ quét trên full listing theo ngày (phủ dần toàn thị trường, không quét full một lúc) ---
# II_UNIVERSE_AUTO_ROTATE=1

# --- Scanner (ThreadPool + batch; scripts prod đặt sẵn trong run_app.ps1 / run_app.bat) ---
# II_SCAN_MAX_WORKERS=4
# II_SCAN_PREFILTER_MAX_WORKERS=4
# II_SCAN_SYMBOL_BATCH_SIZE=32
# II_SCAN_PRESELECT_LIMIT_CAP=350
# II_BG_BATCH_SIZE=8
# II_BG_MAX_SYMBOLS=60

# --- Guardian runtime (chống spam cảnh báo + health artifact) ---
# II_GUARDIAN_COOLDOWN_MINUTES=180
# II_GUARDIAN_STATE_PATH=data/runtime_guardian_state.json
# II_GUARDIAN_HEALTH_PATH=artifacts/operations/runtime_guardian_health.json
# II_RUNTIME_INCIDENT_LOG=data/reports/logs/runtime_incidents.jsonl

# --- Intraday flow detector (Big Boys) — chỉ dùng nguồn miễn phí ---
# II_FLOW_RESOLUTION=D                # D | 1 | 3 | 5 | 15 | 30 | 60 (phút). D = dùng daily portal cache; còn lại bật intraday VNDirect→TCBS
# II_FLOW_PRIMARY_SOURCE=vndirect     # vndirect | tcbs
# II_FLOW_MIN_INTENSITY=6.0           # ngưỡng intensity tối thiểu để bắn alert (1..10)
# II_FLOW_MAX_SYMBOLS=30              # số mã / cycle (0 = tắt cycle)
# II_FLOW_SESSIONS=200                # số nến lấy về mỗi mã
# II_FLOW_COOLDOWN_MINUTES=180        # cooldown alert mỗi mã+intensity bucket
# II_FLOW_SKIP_OUTSIDE_HOURS=1        # 1 = skip khi sàn VN đóng cửa (chỉ áp dụng khi resolution intraday)
# II_FLOW_GUARDIAN_STATE_PATH=data/flow_guardian_state.json
# II_FLOW_GUARDIAN_HEALTH_PATH=artifacts/operations/intraday_flow_guardian_health.json
# II_INTRADAY_TIMEOUT_SEC=6
# II_INTRADAY_CACHE_TTL_SEC=30
# II_INTRADAY_RETRY_ATTEMPTS=2          # số lần thử lại khi nguồn trả 429/503
# II_INTRADAY_RETRY_BACKOFF_SEC=0.5     # backoff cơ bản giữa các lần retry (exp)
# II_INTRADAY_BREAKER_FAILURES=3        # sau N lần fail liên tiếp → mở circuit breaker
# II_INTRADAY_BREAKER_COOLDOWN_SEC=180  # bao lâu source bị skip khi breaker open
# II_INTRADAY_EXTRA_SOURCES=             # extend chain: vd "dnse,ssi" (tuỳ source đã register_intraday_source)

# --- Sector-aware orchestrator (loại tín hiệu "lẻ loi cơ cấu" + boost sóng ngành) ---
# Pass-2 sau analyze_flow per-symbol: aggregate sector_flow_bias rồi adjust
# intensity. Mã bullish cùng chiều ngành bullish ⇒ boost; mã bullish lẻ loi
# trong ngành đang bearish ⇒ penalty (có thể là quỹ cơ cấu, không phải sóng ngành).
# II_FLOW_SECTOR_ADJUST_ENABLED=1
# II_FLOW_SECTOR_ALIGNMENT_BOOST=1.10    # hệ số nhân khi mã cùng chiều bias ngành (cap 1.5)
# II_FLOW_SECTOR_DIVERGENCE_PENALTY=0.85 # hệ số nhân khi mã ngược chiều ngành (min 0.5)

# --- Journal cross-process safety ---
# II_FLOW_JOURNAL_FILE_LOCK=1            # bật file lock cross-process (POSIX fcntl / Windows msvcrt)
# II_FLOW_JOURNAL_LOCK_TIMEOUT_SEC=2.0   # tối đa chờ acquire lock (Windows polling)
# II_FLOW_JOURNAL_LOCK_INTERVAL_SEC=0.01 # polling interval khi contended

# --- Smart money auto-seed (free CafeF/VietStock news) ---
# II_SMART_MONEY_SEED_ENABLED=1
# II_SMART_MONEY_SEED_NEWS_LIMIT=20
# II_SMART_MONEY_SEED_MAX_PER_SYMBOL=200
# II_SMART_MONEY_SEED_STATE_PATH=data/runtime/smart_money_seed_last_run.txt
# II_SMART_MONEY_SEED_OUTPUT_PATH=data/smart_money_events.json

# --- Flow signal journal (audit + backtest dataset) ---
# II_FLOW_JOURNAL_DIR=data/runtime/flow_journal
# II_FLOW_JOURNAL_MAX_FILE_MB=25
# II_FLOW_JOURNAL_RETENTION_WEEKS=8
# II_FLOW_JOURNAL_PRUNE_PER_CYCLE=0     # set 1 để tự xoá file cũ mỗi cycle

# --- Auto-tune min_intensity từ backtest (self-tuning loop) ---
# Sau khi chạy: python scripts/backtest_flow_signals.py --symbols ...
# file artifacts/flow_backtest/recommendation_latest.json sẽ được tạo.
# Set II_FLOW_USE_BACKTEST_RECOMMENDATION=1 để background_jobs đọc và áp dụng
# tự động (chỉ khi II_FLOW_MIN_INTENSITY KHÔNG set explicit).
# II_FLOW_USE_BACKTEST_RECOMMENDATION=0
# II_FLOW_RECOMMENDATION_PATH=artifacts/flow_backtest/recommendation_latest.json
# II_FLOW_RECOMMENDATION_TTL_DAYS=14    # quá hạn ⇒ fallback default thay vì áp số cũ

# --- Scanner re-rank theo flow journal (opt-in; default OFF) ---
# Khi bật, mỗi lần quét sẽ đọc các FlowSignal mới nhất trong journal và áp
# boost/penalty lên Confidence của ứng viên trước khi hiển thị. Không thêm
# network call (chỉ đọc local JSONL ⇒ an toàn cho UI thread).
# II_SCANNER_FLOW_RERANK_ENABLED=0
# II_SCANNER_FLOW_RERANK_LOOKBACK_HOURS=24   # cửa sổ đọc journal
# II_SCANNER_FLOW_RERANK_WEIGHT=0.25         # trọng số áp lên confidence

# --- News/Macro catalyst boost Autopilot (opt-in; default OFF) ---
# Post-scan only: đọc disk/heuristic, không HTTP trong vòng quét _one_symbol.
# II_SCANNER_NEWS_MACRO_BOOST=0
# II_NEWS_MACRO_SCORE_WEIGHT=1.0            # hệ số cộng vào __score (bias * 10 * weight)
# II_MACRO_SNAPSHOT_TTL_SEC=7200            # 1–4h (clamp 3600–14400)
# II_MACRO_SNAPSHOT_PATH=data/runtime/macro_snapshot.json
# II_MACRO_LIVE_REFRESH=1                   # thử USD/VND khi snapshot hết TTL
# II_MACRO_POLICY_RATE_PCT=4.5              # lãi suất điều hành proxy (SBV)
# II_MACRO_CPI_YOY_PCT=0                    # CPI YoY % (optional)
# II_CFO_BACKFILL=1                              # khi disk thiếu CFO, thử vnstock cash_flow (mặc định bật)
# II_VNSTOCK_FETCH_STATEMENTS=1             # kéo CFO/NI từ cash_flow + income khi refresh live
# II_WATCHLIST=FPT,HPG,VNM,ACB,QTP          # dùng với refresh --watchlist

# --- Timeout HTTP (giây): portal + scraper dùng chung ---
# II_HTTP_TIMEOUT=12
# VALUE_INVESTOR_SCRAPER_TIMEOUT=18

# --- API BCTC tùy chỉnh (nếu có backend riêng) ---
# VALUE_INVESTOR_FINANCIAL_API_URL=https://example.com/api/v1/financials

# --- P3 Moat & production ---
# Universe thanh khoản động (avg vol 20 phiên từ ohlcv_store): dynamic_liquid | liquid | vn30 | rotate_full
# II_AUTOPILOT_UNIVERSE_MODE=dynamic_liquid
# Production: Postgres mặc định + worker (verify: python scripts/ensure_production_profile.py --strict)
# II_ENV=prod
# II_DB_URL=postgresql://ii_user:ii_pass@localhost:5432/ii_app
# II_USE_PG_ANALYSIS_JOBS=1
# Growth / audit tuần: python scripts/export_weekly_growth_report.py
# python scripts/export_process_audit_pack.py

# --- Cảnh báo Telegram / email (có thể cấu hình trong UI) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ALLOWED_CHAT_IDS=   # optional: comma-separated chat/user ids
# II_TG_ALERT_INTERVAL_SEC=900
# II_TG_PRICE_ALERT_PCT=3
# Daemon: python scripts/run_telegram_bot_daemon.py
# Dry-run: python scripts/run_telegram_bot_daemon.py --dry-run
# ALERT_WEBHOOK_URL=
# ALERT_EMAIL_TO=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
