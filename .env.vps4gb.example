# Cấu hình khuyến nghị cho VPS 4GB RAM (Windows/Linux)
# Cách dùng:
# 1) Sao chép file này thành `.env`
# 2) Điền các secret thực tế (API key, Telegram, SMTP...)
# 3) Khởi động app/scheduler

# =============================
# Runtime / bảo mật
# =============================
II_LOG_JSON=1
II_LOG_LEVEL=INFO
II_REQUIRE_APP_SECRET_KEY=1
# II_APP_SECRET_KEY=your_fernet_key_here

# =============================
# Database runtime
# =============================
# Nếu chưa có PostgreSQL, giữ SQLite:
# II_DB_URL=sqlite:///data/app_state.db
# Nếu đã có PostgreSQL production:
# II_DB_URL=postgresql://ii_user:ii_pass@localhost:5432/ii_app

# =============================
# Scanner & background (tối ưu RAM 4GB)
# =============================
II_SCAN_MAX_WORKERS=4
II_SCAN_PREFILTER_MAX_WORKERS=6
II_SCAN_SYMBOL_BATCH_SIZE=16
II_SCAN_PRESELECT_LIMIT_CAP=220

II_BG_BATCH_SIZE=6
II_BG_MAX_SYMBOLS=40

# =============================
# Guardian runtime
# =============================
II_GUARDIAN_COOLDOWN_MINUTES=180
II_GUARDIAN_STATE_PATH=data/runtime_guardian_state.json
II_GUARDIAN_HEALTH_PATH=artifacts/operations/runtime_guardian_health.json
II_RUNTIME_INCIDENT_LOG=data/reports/logs/runtime_incidents.jsonl

# =============================
# HTTP timeout (an toàn cho VPS)
# =============================
II_HTTP_TIMEOUT=12
VALUE_INVESTOR_SCRAPER_TIMEOUT=18

# =============================
# Universe / data policy
# =============================
II_UNIVERSE_AUTO_ROTATE=1
# Quét đêm liquid (~400) theo batch; sáng Autopilot lấy Top 10 từ board đã lưu
II_AUTOPILOT_NIGHTLY_BOARD=1
II_AUTOPILOT_NIGHTLY_MAX_AGE_HOURS=36
II_AUTOPILOT_NIGHTLY_MIN_COVERAGE_PCT=25
# Cron: python scripts/run_autopilot_nightly_scan.py --batch-size 40
II_VN_SYMBOL_GUARD=1
II_SNAPSHOT_PREFER_LIVE=1
II_SNAPSHOT_ATTACH_LIVE=1
II_MERGE_LIVE_FUNDAMENTALS=1

# =============================
# Notification (điền khi dùng)
# =============================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=
# ALERT_EMAIL_TO=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# =============================
# LLM keys (tuỳ chọn)
# =============================
# GROQ_API_KEYS=
# OPENAI_API_KEYS=
# GEMINI_API_KEYS=
