# Cấu hình fallback cho VPS 2GB RAM (ưu tiên ổn định hơn tốc độ)
# Cách dùng:
# 1) Sao chép file này thành `.env`
# 2) Điền các secret thực tế

# =============================
# Runtime / bảo mật
# =============================
II_LOG_JSON=1
II_LOG_LEVEL=INFO
II_REQUIRE_APP_SECRET_KEY=1
# II_APP_SECRET_KEY=your_fernet_key_here

# =============================
# Database runtime
# =============================
# Khuyến nghị PostgreSQL nếu có, nếu chưa có dùng SQLite:
# II_DB_URL=sqlite:///data/app_state.db

# =============================
# Scanner & background (siêu tiết kiệm RAM)
# =============================
II_SCAN_MAX_WORKERS=2
II_SCAN_PREFILTER_MAX_WORKERS=3
II_SCAN_SYMBOL_BATCH_SIZE=8
II_SCAN_PRESELECT_LIMIT_CAP=120

II_BG_BATCH_SIZE=4
II_BG_MAX_SYMBOLS=20

# =============================
# Guardian runtime
# =============================
II_GUARDIAN_COOLDOWN_MINUTES=240
II_GUARDIAN_STATE_PATH=data/runtime_guardian_state.json
II_GUARDIAN_HEALTH_PATH=artifacts/operations/runtime_guardian_health.json
II_RUNTIME_INCIDENT_LOG=data/reports/logs/runtime_incidents.jsonl

# =============================
# Timeout mạng
# =============================
II_HTTP_TIMEOUT=14
VALUE_INVESTOR_SCRAPER_TIMEOUT=22

# =============================
# Data policy
# =============================
II_UNIVERSE_AUTO_ROTATE=1
# Quét đêm batch nhỏ hơn (ổn định RAM); sáng phục vụ Top 10 từ board
II_AUTOPILOT_NIGHTLY_BOARD=1
II_AUTOPILOT_NIGHTLY_MAX_AGE_HOURS=36
II_AUTOPILOT_NIGHTLY_MIN_COVERAGE_PCT=20
# Cron: python scripts/run_autopilot_nightly_scan.py --batch-size 20 --workers 2
II_VN_SYMBOL_GUARD=1
II_SNAPSHOT_PREFER_LIVE=1
II_SNAPSHOT_ATTACH_LIVE=1
II_MERGE_LIVE_FUNDAMENTALS=1

# =============================
# Notification (điền khi dùng)
# =============================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=
# ALERT_EMAIL_TO=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# =============================
# LLM keys (tuỳ chọn)
# =============================
# GROQ_API_KEYS=
# OPENAI_API_KEYS=
# GEMINI_API_KEYS=
